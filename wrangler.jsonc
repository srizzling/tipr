{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thisispodracing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  // The builds board (functions/api/builds). Created by OpenTofu; the id below is `tofu output builds_database_id` in infra/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thisispodracing-builds",
      "database_id": "6163d9de-8d01-4673-b7fc-c6e310ba64c1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "1" renders a per-build preview image on demand. Needs Cloudflare's paid Workers plan (CPU limit).
    "DYNAMIC_OG": "0"
  }
}
