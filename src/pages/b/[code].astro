---
import Base from '../../layouts/Base.astro';
import BuildView from '../../components/BuildView';
import { gameData } from '../../data';

// One static shell for every shared build. The host rewrites /b/<code> to this page (public/_redirects,
// and a dev-server middleware in astro.config.mjs); the component reads the code from the URL.
export function getStaticPaths() {
  return [{ params: { code: '_' } }];
}
---

<Base title="Shared build · This Is Pod Racing">
  <BuildView client:only="react" data={gameData} />
</Base>
