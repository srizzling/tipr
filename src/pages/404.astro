---
import Ref from '../layouts/Ref.astro';
---

<Ref
  title="Page not found"
  description="That page does not exist on This Is Pod Racing."
  heading="Page not found"
  kicker="404"
>
  <p slot="meta" class="lede">That address does not lead anywhere. It may have moved, or the link was cut off.</p>
  <section class="panel">
    <h2 class="panel-title"><span>Try one of these</span></h2>
    <div class="list">
      <a class="card" href="/"><span><b>Build planner</b><small>Plan and share a build</small></span></a>
      <a class="card" href="/styles/"><span><b>Racer styles</b><small>Traits, ranks and unlocks</small></span></a>
      <a class="card" href="/abilities/"><span><b>Abilities</b><small>Every ability and its tiers</small></span></a>
      <a class="card" href="/parts/"><span><b>Parts</b><small>Prices, effects and unlocks</small></span></a>
      <a class="card" href="/glossary/"><span><b>Glossary</b><small>What Burning, Surge and the rest mean</small></span></a>
    </div>
  </section>
</Ref>
