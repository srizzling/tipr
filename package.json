{
  "name": "tipr",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc -p functions/tsconfig.json",
    "check:links": "node scripts/check-links.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "data:check": "node scripts/scrape-data.mjs build --check",
    "data:refresh": "node scripts/scrape-data.mjs all --refresh",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "dev:functions": "astro build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}